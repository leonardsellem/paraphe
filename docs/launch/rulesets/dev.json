{
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/dev"
      ]
    }
  },
  "enforcement": "active",
  "name": "dev",
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "parameters": {
        "allowed_merge_methods": [
          "squash"
        ],
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_extra_approval_for_unattributed_changes": true,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": false,
        "required_reviewers": []
      },
      "type": "pull_request"
    },
    {
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "suite (python 3.11 on ubuntu-latest)"
          },
          {
            "context": "suite (python 3.12 on ubuntu-latest)"
          },
          {
            "context": "suite (python 3.13 on ubuntu-latest)"
          },
          {
            "context": "suite (python 3.11 on macos-latest)"
          },
          {
            "context": "suite (python 3.12 on macos-latest)"
          },
          {
            "context": "suite (python 3.13 on macos-latest)"
          },
          {
            "context": "the distribution installs and the command runs"
          },
          {
            "context": "the container builds and reports ready"
          },
          {
            "context": "the tracked tree carries no private term"
          },
          {
            "context": "the pushed commit messages carry no private term"
          }
        ],
        "strict_required_status_checks_policy": false
      },
      "type": "required_status_checks"
    }
  ],
  "target": "branch"
}
