        }
      ]
    },
    {
      "id": "claim_cc853520e56f4d82b2647af4d983a0b6",
      "statement": "`paraphe store` accepts exactly `relocate` or `relocate --move`; any other argument list prints the store usage on stderr with exit 2, while `-h`, `--help` and `help` print the same usage on stdout with exit 0.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/__main__.py#L61-L64",
          "version": "repo-lines-v1:sha256:65713445132fd528d12250a1ee44ad143f599b8c5e15ffe0cab801dd5908403f:"
        },
        {
