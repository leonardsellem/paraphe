  "claims": [
    {
      "id": "claim_f3090f086b214e4c9f16551a95075b0c",
      "statement": "`paraphe check` accepts exactly the single argument list `telegram`; any other argument list is refused with the one line `paraphe: check needs exactly 'telegram'` on stderr and exit code 2, and `check` has no help form of its own.",
      "evidence": [
        {
          "resource": "repo://src/paraphe/__main__.py#L57-L60",
          "version": "repo-lines-v1:sha256:0e4a6bb96f2a4c3174fba2c99d609911f925f5459ee7dab0e6fe95506b820241:"
        },
        {
